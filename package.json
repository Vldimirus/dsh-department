{
  "name": "dsh-department",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "AI development department for DeepSeek Harness: tasks, stages, gates, git workflow, budgets, roles and a pixel office.",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "agents",
    "department",
    "workflow",
    "git",
    "i18n",
    "pixel-office"
  ],
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "src",
    "assets",
    "templates",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dependencies": {
    "playwright": "^1.65.1",
    "sharp": "^0.35.5"
  },
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vldimirus/dsh-department.git"
  },
  "homepage": "https://github.com/Vldimirus/dsh-department#readme",
  "bugs": {
    "url": "https://github.com/Vldimirus/dsh-department/issues"
  }
}